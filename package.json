{
    "name": "root",
    "private": true,
    "scripts": {
        "lint": "pnpm --stream --filter {packages/**} --filter {examples/**} lint",
        "lint:fix": "pnpm --stream --filter {packages/**} --filter {examples/**} lint:fix",
        "format": "pnpm --stream --filter {packages/**} --filter {examples/**} format",
        "format:check": "pnpm --stream --filter {packages/**} --filter {examples/**} format:check",
        "test": "pnpm test:unit && pnpm test:components",
        "test:components": "cypress run --component",
        "test:components:browser": "cypress open --component",
        "test:unit": "vitest run",
        "test:unit:ui": "vitest --ui",
        "test:unit:watch": "vitest",
        "typecheck": "pnpm --stream --filter {packages/**} --filter {examples/**} typecheck",
        "deploy": "pnpm --stream --filter {packages/**} deploy",
        "ci": "pnpm install --frozen-lockfile"
    },
    "dependencies": {
        "@frontify/fondue": "13.7.8",
        "glob": "^13.0.6",
        "happy-dom": "^20.8.9",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@4tw/cypress-drag-drop": "^2.3.1",
        "@babel/core": "^7.29.0",
        "@cypress/vite-dev-server": "^7.2.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/ui": "^4.1.4",
        "cypress": "^15.13.0",
        "cypress-real-events": "^1.15.0",
        "msw": "^2.12.14",
        "oxlint": "^1.74.0",
        "oxlint-tsgolint": "^0.24.0",
        "postcss": "^8.5.8",
        "tailwindcss": "^3.4.17",
        "terser": "^5.46.1",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.2",
        "vite": "^7.3.2",
        "vitest": "^4.1.4"
    },
    "engines": {
        "node": ">=26",
        "pnpm": ">=11.0.0"
    },
    "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
